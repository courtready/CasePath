RewriteEngine On

# Canonical host + HTTPS: casepath.com.au is primary
RewriteCond %{HTTP_HOST} !^casepath\.com\.au$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^ https://casepath.com.au%{REQUEST_URI} [L,R=301]

# Serve SPA for these paths (Apache may otherwise map /kids or /your-team to the static .html files via MultiViews).
RewriteRule ^kids/?$ index.html [L]
RewriteRule ^your-team/?$ index.html [L]

# Security hardening headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://esm.sh https://*.supabase.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co https://api.stripe.com https://js.stripe.com; frame-src 'self' https://js.stripe.com https://hooks.stripe.com; object-src 'none'; base-uri 'self'; form-action 'self';"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache static assets aggressively
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 year"
</IfModule>

# No-store for HTML documents
<FilesMatch "\.(html?)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|shtml|js|css)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# SPA fallback — never map missing /components or /assets to index.html (breaks fragment loaders)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteCond %{REQUEST_URI} !^/components/ [NC]
RewriteCond %{REQUEST_URI} !^/assets/ [NC]
# Do not serve the SPA for these paths if the .html file is missing (avoid a fake "home" page on 404).
RewriteCond %{REQUEST_URI} !/(mission|glossary|mental-health|kids|your-team|support-tools|maintenance)\.html$ [NC]
RewriteRule ^ index.html [L]
